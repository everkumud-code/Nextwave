generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum MemberRole {
  OWNER
  ADMIN
  MANAGER
  AGENT
  VIEWER
}

enum SenderOwnership {
  CUSTOMER
  PLATFORM
}

enum SenderConnector {
  QR_SESSION
  META_CLOUD_API
  OTHER
}

enum SenderStatus {
  PENDING
  CONNECTED
  ATTENTION
  DISCONNECTED
  RESTRICTED
  ARCHIVED
}

enum QrSessionStatus {
  CREATED
  QR_PENDING
  PAIRING
  CONNECTED
  RECONNECTING
  DISCONNECTED
  REVOKED
  ERROR
}

enum ContactStatus {
  ACTIVE
  UNSUBSCRIBED
  INVALID
  BLOCKED
}

enum ConsentStatus {
  GRANTED
  WITHDRAWN
  UNKNOWN
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  QUEUED
  RUNNING
  PAUSED
  COMPLETED
  CANCELLED
  FAILED
}

enum MessageStatus {
  QUEUED
  SUBMITTED
  SENT
  DELIVERED
  READ
  FAILED
  CANCELLED
}

enum AuditActorType {
  USER
  SYSTEM
  API
}

enum CreditTransactionType {
  CREDIT
  DEBIT
  ADJUSTMENT
}

model Organization {
  id          String             @id @default(cuid())
  name        String
  slug        String             @unique
  status      OrganizationStatus @default(ACTIVE)
  timezone    String             @default("Asia/Kolkata")
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  memberships Membership[]
  senders     Sender[]
  contacts    Contact[]
  contactGroups ContactGroup[]
  campaigns   Campaign[]
  sessions    QrSession[]
  qrCredentials QrCredential[]
  deliveryReceipts QrDeliveryReceipt[]
  providerDeliveryReceipts ProviderDeliveryReceipt[]
  auditLogs   AuditLog[]
  creditAccount CreditAccount?
  creditTransactions CreditTransaction[]
  invitations OrganizationInvite[]
}

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  name          String?
  passwordHash  String?
  emailVerified DateTime?
  image         String?
  isPlatformAdmin Boolean    @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  memberships   Membership[]
  auditLogs     AuditLog[]
}

model Membership {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  role           MemberRole   @default(AGENT)
  invitedAt      DateTime?
  joinedAt       DateTime?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId, role])
  @@index([organizationId, role])
}

model Sender {
  id                 String          @id @default(cuid())
  organizationId     String
  displayName        String
  phoneNumber        String
  phoneNumberE164    String
  ownership          SenderOwnership @default(CUSTOMER)
  connector          SenderConnector
  status             SenderStatus    @default(PENDING)
  providerAccountRef String?
  assignedLabel      String?
  lastConnectedAt    DateTime?
  lastSeenAt         DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  archivedAt         DateTime?
  organization       Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sessions           QrSession[]
  qrCredentials      QrCredential[]
  deliveryReceipts   QrDeliveryReceipt[]
  providerDeliveryReceipts ProviderDeliveryReceipt[]
  campaigns          Campaign[]
  messages           Message[]

  @@unique([organizationId, phoneNumberE164])
  @@index([organizationId, status])
  @@index([organizationId, ownership])
  @@index([connector, status])
}

model QrSession {
  id                 String          @id @default(cuid())
  organizationId     String
  senderId            String
  ownership          SenderOwnership
  status             QrSessionStatus @default(CREATED)
  providerSessionId  String?
  activeKey          String?         @unique
  credentialRef      String?
  connectedAt        DateTime?
  lastSeenAt         DateTime?
  lastErrorCode      String?
  lastErrorMessage   String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  revokedAt          DateTime?
  organization       Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sender             Sender          @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([organizationId, senderId, status])
  @@index([providerSessionId])
  @@index([status, lastSeenAt])
}

model QrCredential {
  id              String        @id
  organizationId  String
  senderId        String
  encryptedCreds  String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sender          Sender        @relation(fields: [senderId], references: [id], onDelete: Cascade)
  signalKeys      QrSignalKey[]

  @@index([organizationId, senderId])
}

model QrSignalKey {
  id             String       @id @default(cuid())
  credentialId   String
  keyType        String
  keyId          String
  encryptedValue String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  credential     QrCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  @@unique([credentialId, keyType, keyId])
  @@index([credentialId, keyType])
}

model Contact {
  id              String        @id @default(cuid())
  organizationId  String
  phoneNumber     String
  phoneNumberE164 String
  firstName       String?
  lastName        String?
  email           String?
  company         String?
  customFields    Json?
  status          ContactStatus @default(ACTIVE)
  source          String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  consents        ConsentRecord[]
  campaignTargets CampaignRecipient[]
  groupMemberships ContactGroupMember[]

  @@unique([organizationId, phoneNumberE164])
  @@index([organizationId, status])
  @@index([organizationId, email])
}

model ConsentRecord {
  id              String        @id @default(cuid())
  contactId       String
  channel         String
  purpose         String
  status          ConsentStatus @default(UNKNOWN)
  source          String?
  evidenceRef     String?
  noticeVersion   String?
  grantedAt       DateTime?
  withdrawnAt    DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  contact         Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId, channel, purpose, status])
}

model Campaign {
  id              String         @id @default(cuid())
  organizationId  String
  senderId        String?
  name            String
  description     String?
  messageBody     String?
  status          CampaignStatus @default(DRAFT)
  channel         String         @default("WHATSAPP")
  scheduledAt     DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sender          Sender?        @relation(fields: [senderId], references: [id], onDelete: SetNull)
  recipients      CampaignRecipient[]
  messages        Message[]

  @@index([organizationId, status, scheduledAt])
  @@index([senderId, status])
}

model CampaignRecipient {
  id          String    @id @default(cuid())
  campaignId  String
  contactId   String
  status      String    @default("PENDING")
  createdAt   DateTime  @default(now())
  campaign    Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact     Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([campaignId, contactId])
  @@index([campaignId, status])
  @@index([contactId])
}

model Message {
  id                String        @id @default(cuid())
  organizationId    String
  campaignId        String?
  senderId          String?
  recipientE164     String
  body              String?
  status            MessageStatus @default(QUEUED)
  idempotencyKey    String
  chargePaise       Int           @default(0)
  providerMessageId String?
  attemptCount      Int           @default(0)
  maxAttempts       Int           @default(5)
  nextAttemptAt    DateTime      @default(now())
  lockedAt         DateTime?
  lockToken        String?
  lastAttemptAt    DateTime?
  errorCode         String?
  errorMessage      String?
  submittedAt       DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  campaign          Campaign?     @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  sender            Sender?       @relation(fields: [senderId], references: [id], onDelete: SetNull)

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, status, createdAt])
  @@index([campaignId, status])
  @@index([providerMessageId])
  @@index([status, nextAttemptAt, lockedAt])
}

model AuditLog {
  id              String         @id @default(cuid())
  organizationId  String
  actorUserId     String?
  actorType       AuditActorType @default(USER)
  action          String
  resourceType    String
  resourceId      String?
  ipAddress       String?
  userAgent       String?
  metadata        Json?
  createdAt       DateTime       @default(now())
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor           User?          @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([resourceType, resourceId])
  @@index([actorUserId, createdAt])
}


enum QrDeliveryStatus {
  SENT
  DELIVERED
  READ
  FAILED
}

model QrDeliveryReceipt {
  id               String           @id @default(cuid())
  organizationId   String
  senderId         String
  providerMessageId String
  status           QrDeliveryStatus
  receivedAt       DateTime         @default(now())
  appliedAt        DateTime?
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sender           Sender           @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@unique([organizationId, senderId, providerMessageId])
  @@index([organizationId, senderId, appliedAt])
}


model ContactGroup {
  id             String              @id @default(cuid())
  organizationId String
  name           String
  description    String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members        ContactGroupMember[]

  @@unique([organizationId, name])
  @@index([organizationId, updatedAt])
}

model ContactGroupMember {
  id        String       @id @default(cuid())
  groupId   String
  contactId String
  createdAt DateTime     @default(now())
  group     ContactGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  contact   Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([groupId, contactId])
  @@index([contactId])
}


model ProviderDeliveryReceipt {
  id                String                 @id @default(cuid())
  organizationId    String
  senderId          String
  providerMessageId String
  status            QrDeliveryStatus
  eventTimestamp    DateTime
  errorCode         String?
  errorMessage      String?
  receivedAt        DateTime               @default(now())
  appliedAt         DateTime?
  organization      Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sender            Sender                 @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@unique([organizationId, senderId, providerMessageId, status, eventTimestamp])
  @@index([organizationId, senderId, providerMessageId, appliedAt])
}


model CreditAccount {
  id              String       @id @default(cuid())
  organizationId  String       @unique
  balancePaise    Int          @default(0)
  pricePerMessagePaise Int     @default(10)
  defaultIntervalSeconds Int   @default(60)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transactions    CreditTransaction[]

  @@index([updatedAt])
}

model CreditTransaction {
  id              String                @id @default(cuid())
  organizationId  String
  accountId       String
  type            CreditTransactionType
  amountPaise     Int
  balanceAfterPaise Int
  pricePerMessagePaise Int?
  messageCount    Int?
  reference       String?
  description     String?
  actorUserId     String?
  createdAt       DateTime              @default(now())
  organization    Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  account         CreditAccount         @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([accountId, createdAt])
  @@index([reference])
}


model OrganizationInvite {
  id              String       @id @default(cuid())
  organizationId  String
  email           String
  role            MemberRole   @default(AGENT)
  tokenHash       String       @unique
  expiresAt       DateTime
  acceptedAt      DateTime?
  invitedByUserId String
  createdAt       DateTime     @default(now())
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([organizationId, email])
}
