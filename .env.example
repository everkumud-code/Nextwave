# Application
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
NEXT_PUBLIC_APP_URL=http://localhost:3000
PLATFORM_ADMIN_EMAILS=admin@example.com
APP_ENCRYPTION_KEY=replace-with-a-32-byte-secret

# PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/nextwave?sslmode=require

# Redis / BullMQ
REDIS_URL=

# Meta WhatsApp Cloud API (configure only after Meta app setup)
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=
META_WEBHOOK_VERIFY_TOKEN=

# Secrets provider / object storage
CREDENTIALS_VAULT_KEY=
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=

# Self-hosted QR session service (server-side only)
QR_SESSION_SERVICE_URL=http://localhost:4100
QR_SESSION_SERVICE_TOKEN=
QR_SESSION_REQUEST_TIMEOUT_MS=30000

# QR runtime service
QR_SESSION_PORT=4100
QR_CREDENTIAL_ENCRYPTION_KEY=replace-with-64-hex-characters-for-a-32-byte-key

# Persistent message queue worker (keep disabled until a connector is configured)
QUEUE_WORKER_ENABLED=false
QUEUE_WORKER_BATCH_SIZE=25
QUEUE_WORKER_POLL_INTERVAL_MS=1000
