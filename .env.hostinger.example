# Copy this file to .env.hostinger on the VPS. Never commit real values.
# Use the exact public HTTPS subdomain configured in DNS and Nginx.
NEXT_PUBLIC_APP_URL=https://nextwave.example.com

# Generate a unique random string of at least 32 characters.
AUTH_SECRET=REPLACE_WITH_64_PLUS_RANDOM_CHARACTERS
PLATFORM_ADMIN_EMAILS=admin@example.com

# PostgreSQL runs only inside the private Docker network.
POSTGRES_DB=nextwave
POSTGRES_USER=nextwave
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DATABASE_PASSWORD
# URL-encode any reserved characters in the password for this connection URL.
DATABASE_URL=postgresql://nextwave:URL_ENCODED_PASSWORD@db:5432/nextwave

# Generate one high-entropy token and keep the same value for web + QR runtime.
QR_SESSION_SERVICE_TOKEN=REPLACE_WITH_LONG_RANDOM_TOKEN
# Exactly 64 hexadecimal characters (32 random bytes). Back this up securely.
QR_CREDENTIAL_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS

# Keep false during initial setup. Enable only after sender pairing and a controlled test.
QUEUE_WORKER_ENABLED=false
