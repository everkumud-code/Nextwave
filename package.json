{
  "name": "nextwave-multisender",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "qr:dev": "node --env-file=.env.local --import tsx services/qr-runtime/src/index.ts",
    "qr:typecheck": "tsc -p services/qr-runtime/tsconfig.json --noEmit",
    "qr:build": "tsc -p services/qr-runtime/tsconfig.json",
    "qr:start": "node services/qr-runtime/dist/index.js",
    "test": "tsx --test src/lib/sessions/*.test.ts src/lib/*.test.ts"
  },
  "dependencies": {
    "@tailwindcss/forms": "^0.5.10",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "^15.5.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^2.6.0",
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^2.4.3",
    "jose": "^5.9.6",
    "qrcode.react": "^4.2.0",
    "@whiskeysockets/baileys": "^6.7.18",
    "@hapi/boom": "^10.0.1",
    "pino": "^9.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.6",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "prisma": "^6.19.0",
    "@types/bcryptjs": "^2.4.6",
    "tsx": "^4.19.2"
  }
}
